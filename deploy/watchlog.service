[Unit]
Description=Watch log: movies and shows we've watched
After=network-online.target
Wants=network-online.target

[Service]
User=watchlog
WorkingDirectory=/opt/watchlog
# the package lives at /opt/watchlog/watchlog/
Environment=PYTHONPATH=/opt/watchlog
ExecStart=/usr/bin/python3 -m watchlog --db /var/lib/watchlog/watchlog.db --port 9280
# /var/lib/watchlog: the database and posters, readable only by the service
StateDirectory=watchlog
StateDirectoryMode=0750
UMask=0027
Restart=always
RestartSec=5

# Sandbox: it only needs its own folder, the network and Python
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
